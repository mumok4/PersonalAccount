@model BranchSettingsModel

<div class="container">

    @if (ViewData["Error"] != null)
    {
        <div class="alert alert-danger">@ViewData["Error"]</div>
    }

    <form method="get" asp-action="Index">
        <div class="form-group mb-3">
            <label class="form-label">Филиал:</label>
            <select class="form-select" name="branchId" onchange="this.form.submit()"
                    asp-items="@(new SelectList(Model.Branches, "Id", "Name", Model.BranchId))">
            </select>
        </div>
    </form>

    <form method="post" asp-action="SaveSettings">
        <input type="hidden" asp-for="BranchId" />

        <div class="form-group mb-2">
            <label class="form-label">Описание:</label>
            <input type="text" class="form-control" asp-for="Description" />
        </div>

        <div class="form-group mb-2">
            <label class="form-label">Начальная позиция:</label>
            <input type="number" class="form-control" asp-for="StartPosition" />
        </div>

        <div class="form-group mb-2">
            <label class="form-label">Размер пачки:</label>
            <input type="number" class="form-control" asp-for="BatchSize" />
        </div>

        <div class="mt-3">
            <button type="submit" class="btn btn-primary">Сохранить</button>
            <button type="reset" class="btn btn-secondary">Сбросить</button>
        </div>
    </form>

</div>
